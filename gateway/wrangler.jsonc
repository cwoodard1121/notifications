// Cloudflare Worker "agent-bus-phone": the phone gateway for the Agent Bus.
// Contract: ../docs/PHONE-GATEWAY.md. Secrets (Twilio, OWNER_NUMBER, TOKEN_*) are set with
// `npx wrangler secret put NAME` and never appear in this file.
{
  "name": "agent-bus-phone",
  // Cameron's own account (his login can also see another account; wrangler can't choose non-interactively).
  "account_id": "64c02204b226fcac8b4dd7fbb893a493",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "PhoneGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhoneGateway"] }],
  "vars": {
    "DRY_RUN": "0",
    "TTS_VOICE": "Polly.Matthew-Neural",
    // Spoken first on every call, before the alert title/message and the keypad menu. "" = no intro.
    "CALL_INTRO": "Yo, you have to lock in on this now.",
    "RING_SECONDS": "25",
    "RETRY_MINUTES": "3",
    "SNOOZE_MINUTES": "10",
    "MAX_ATTEMPTS": "2",
    "MAX_SNOOZES": "3",
    "CLIENT_DAILY_CALLS": "30",
    "MAX_DIALS_PER_DAY": "100",
    "MAX_TEXTS_PER_DAY": "100"
  }
}
