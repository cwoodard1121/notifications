DRY_RUN=1
TWILIO_ACCOUNT_SID=ACFAKE0000000000000000000000000000
TWILIO_AUTH_TOKEN=fake-dev-twilio-auth-token-not-real
TWILIO_FROM=+15550100000
OWNER_NUMBER=+15550100001
TOKEN_BUS=gw_bus_DEV-ONLY-fake-token-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TOKEN_PLANNER=gw_planner_DEV-ONLY-fake-token-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
