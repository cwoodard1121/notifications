{
  "description": "Agent Bus: join on SessionStart (command bridge), deliver bus messages on UserPromptSubmit/PreToolUse, go idle on Stop (plus the experimental idle re-wake), leave on SessionEnd. Generated by Install-AgentBus.ps1.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/camer/AppData/Local/Programs/Python/Python312/python.exe\" \"C:/Users/camer/Desktop/Projects/notifications/bus.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/hooks/claude",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/hooks/claude",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/hooks/claude",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/camer/AppData/Local/Programs/Python/Python312/python.exe\" \"C:/Users/camer/Desktop/Projects/notifications/bus.py\" rewake",
            "async": true,
            "asyncRewake": true,
            "timeout": 28800
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/hooks/claude",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
